{
  "compilerOptions": {
    "baseUrl": ".",
    "jsx": "preserve",
    "strict": true,
    "target": "ES2023",
    "module": "ESNext",
    "declaration": false,
    "noImplicitAny": true,
    "removeComments": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "moduleResolution": "Node",
    "sourceMap": true,
    "lib": ["esnext", "dom"],
    "allowSyntheticDefaultImports": true,
    "allowImportingTsExtensions": true,
    "skipDefaultLibCheck": true
  },
  "exclude": [
    "node_modules",
    "**/__test__",
    "dist/**"
  ]
}
